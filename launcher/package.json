{
  "name": "stereum-launcher",
  "version": "2.5.1",
  "private": true,
  "description": "Stereum Ethereum Node Setup Launcher",
  "author": {
    "name": "Stereum Launcher Team",
    "email": "office@stereum.com",
    "url": "https://stereum.com/"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "serve": "electron-vite dev",
    "stereum": "electron-vite dev",
    "electron:serve": "electron-vite dev",
    "backend:watch": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --config electron-builder.config.cjs --publish never",
    "electron:build": "electron-vite build && electron-builder --config electron-builder.config.cjs --publish never",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "postinstall": "electron-builder install-app-deps",
    "postuninstall": "electron-builder install-app-deps",
    "test:unit": "jest '(\\.test|\\.spec)\\.js' --coverage",
    "test:int": "jest '\\.int\\.js'",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:other": "jest --silent --testPathPattern 'tests/(?!.*Service).*\\.int\\.js$'",
    "test:beacon": "jest --silent --testPathPattern 'tests/(?=.*BeaconService).*\\.int\\.js$'",
    "test:service": "jest --silent --testPathPattern 'tests/(?=.*Service)(?!.*Beacon).*\\.int\\.js$'",
    "test:cleanup": "node src/backend/tests/integration/Cleanup.js",
    "format": "prettier .  --write",
    "format:check": "prettier . --check"
  },
  "main": "out/main/index.js",
  "dependencies": {
    "@headlessui/vue": "^1.7.23",
    "@heroicons/vue": "^2.2.0",
    "@sapien99/vue-cli-plugin-electron-builder-notarize": "^1.1.3",
    "@vue-hero-icons/outline": "^1.7.2",
    "@vue-hero-icons/solid": "^1.7.2",
    "@xterm/addon-attach": "^0.12.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "animate.css": "^4.1.1",
    "axios": "^1.18.1",
    "electron-log": "^5.4.4",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "events": "^3.3.0",
    "evilscan": "^1.9.1",
    "file-saver": "^2.0.5",
    "geoip-lite": "^2.0.3",
    "gsap": "^3.15.0",
    "js-yaml": "^4.3.0",
    "json5": "^2.2.3",
    "jszip": "^3.10.1",
    "ping": "^1.0.0",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "semver": "^7.8.5",
    "ssh2": "^1.17.0",
    "swiper": "^12.2.0",
    "tailwindcss-animated": "^2.1.0",
    "uuid": "^11.1.1",
    "vue": "^3.5.40",
    "vue-i18n": "^11.4.7",
    "vue-router": "^5.2.0",
    "vue3-apexcharts": "^1.11.1",
    "vue3-carousel": "^0.17.0",
    "vuedraggable": "^2.24.3",
    "web3": "^4.16.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/runtime": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/compiler-sfc": "^3.5.40",
    "@vueuse/core": "^14.3.0",
    "autoprefixer": "^10.5.4",
    "electron": "^41.10.3",
    "electron-builder": "^26.15.7",
    "electron-vite": "^4.0.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.7.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "postcss": "^8.5.22",
    "prettier": "^3.9.6",
    "tailwind-scrollbar": "^3.1.0",
    "tailwindcss": "^3.4.19",
    "vite": "^7.3.6"
  },
  "license": "https://wrapbootstrap.com/help/licenses",
  "overrides": {
    "serialize-javascript": ">=7.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:stereum-dev/ethereum-node.git"
  }
}